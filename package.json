{
  "name": "dsh-efficiency-guard",
  "version": "0.2.2",
  "description": "DSH plugin that keeps long-running work off the foreground wait path: teaches the background-first recipe and denies blind foreground sleep polling that burns the tool-call budget.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./detect": {
      "default": "./lib/detect.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinchengjian/dsh-efficiency-guard.git"
  },
  "bugs": {
    "url": "https://github.com/yinchengjian/dsh-efficiency-guard/issues"
  },
  "homepage": "https://github.com/yinchengjian/dsh-efficiency-guard#readme",
  "author": "yinchengjian <1591343112@qq.com>",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "efficiency",
    "guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
